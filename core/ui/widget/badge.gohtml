{{- /*gotype: github.com/simpledms/simpledms/core/ui/widget.Badge */ -}}
{{- define "Badge" }}
	<div
			{{/* TODO bg-primary-container instead of bg-primary? */}}
			class="{{ if .IsInverse }}bg-error{{ else }}bg-primary{{ end }} rounded-full
					{{ if .IsSmall }}size-1.5{{ else }}h-4 min-w-4 flex items-center justify-center{{ end }}
					{{ .GetClass }}"
			id="{{ .GetID }}"
			{{ template "HTMXAttrs" .HTMXAttrs }}
	>
		{{- if not .IsSmall -}}
			<span class="{{ if .IsInverse }}text-on-error{{ else }}text-on-primary{{ end }} label-sm">{{ .GetValue }}</span>
		{{- end -}}
	</div>
{{ end }}