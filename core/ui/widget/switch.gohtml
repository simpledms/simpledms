{{- /* gotype: github.com/simpledms/simpledms/core/ui/widget.Switch */ -}}
{{- define "Switch" }}
	{{ $ctx := .GetContext }}
	<label class="group/switch flex min-h-14 w-full cursor-pointer items-center justify-between gap-x-4
			has-[:disabled]:cursor-not-allowed">
		<span class="min-w-0 flex-1">
			<span id="{{ .GetID }}-label" class="body-md block text-on-surface
					group-has-[:disabled]/switch:text-on-surface/[0.38]">
				{{ render $ctx .Label }}
			</span>
			{{- with .SupportingText }}
				<span id="{{ $.GetID }}-supporting-text" class="body-sm block pt-1 text-on-surface-variant
						group-has-[:disabled]/switch:text-on-surface/[0.38]">
					{{ render $ctx . }}
				</span>
			{{- end }}
		</span>
		<span class="relative flex h-12 w-[3.25rem] shrink-0 items-center">
			<input
					{{ template "HTMXAttrs" .HTMXAttrs }}
					id="{{ .GetID }}-switch"
					class="peer absolute inset-0 z-10 size-full cursor-pointer opacity-0
						disabled:cursor-not-allowed"
					type="checkbox"
					role="switch"
					name="{{ .Name }}"
					value="{{ .GetValue }}"
					aria-labelledby="{{ .GetID }}-label"
					{{ if .SupportingText }}aria-describedby="{{ .GetID }}-supporting-text"{{ end }}
					{{ if .IsChecked }}checked{{ end }}
					{{ if .IsDisabled }}disabled{{ end }}
					{{ if .IsRequired }}required{{ end }}
			/>
			<span aria-hidden="true" class="h-8 w-[3.25rem] rounded-full bg-surface-container-highest
					outline outline-2 -outline-offset-2 outline-outline transition-colors
					peer-checked:bg-primary peer-checked:outline-0 peer-disabled:opacity-[0.38]
					peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2
					peer-focus-visible:outline-primary"></span>
			<span aria-hidden="true" class="pointer-events-none absolute left-2 flex size-4 items-center
					justify-center rounded-full bg-outline
					transition-all peer-checked:left-6 peer-checked:size-6 peer-checked:bg-on-primary
					peer-disabled:opacity-[0.38]">
				{{- with .UncheckedIcon }}
					<i class="material-symbols-outlined text-[1rem] leading-none text-surface-container-highest
							group-has-[:checked]/switch:hidden">{{ .Name }}</i>
				{{- end }}
				{{- with .CheckedIcon }}
					<i class="material-symbols-outlined hidden text-[1rem] leading-none text-primary
							group-has-[:checked]/switch:block">{{ .Name }}</i>
				{{- end }}
			</span>
		</span>
	</label>
{{ end }}
