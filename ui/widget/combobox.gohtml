{{- /* gotype: github.com/simpledms/simpledms/ui/widget.Combobox */ -}}
{{- define "Combobox" }}
	<sds-combobox id="{{ .GetID }}" class="block w-full
		[&>menu]:rounded-xl [&>menu]:p-1
		[&_[data-menu-option]]:overflow-hidden [&_[data-menu-option]]:rounded-lg
		[&_[data-selected=true]]:bg-secondary-container
		[&_[data-selected=true]_i]:text-on-secondary-container
		[&_[data-selected=true]_span]:text-on-secondary-container">
		<div class="js-combobox-trigger group/combobox flex min-h-14 cursor-text items-center gap-x-3 rounded-full bg-surface-container-highest px-4
				text-on-surface transition-colors duration-200 hover:bg-surface-container-high
				focus-within:outline focus-within:outline-2 focus-within:-outline-offset-2 focus-within:outline-primary"
				 style="anchor-name: --{{ .GetPopoverTarget }}">
			{{ with .Input.LeadingIcon }}
				<span class="flex size-6 shrink-0 center-aligned text-on-surface-variant">{{ render $.GetContext . }}</span>
			{{ end }}
			<label class="relative flex min-w-0 flex-grow cursor-pointer">
			<input
					type="{{ .Input.GetType }}"
					name="{{ .Input.Name }}"
					placeholder="{{ .Input.Placeholder }}"
					value="{{ .Input.Value }}"
					{{ if .Input.HasAutofocus }}autofocus{{ end }}
					role="combobox" aria-haspopup="menu" aria-expanded="false"
					aria-controls="{{ .GetPopoverTarget }}" autocomplete="off"
					data-selected-value="{{ .Input.Value }}"
					class="js-input min-w-0 w-full bg-transparent label-lg text-on-surface
						placeholder-on-surface-variant focus:outline-none"
                    >
			</label>
			<div class="pointer-events-none flex size-10 shrink-0 items-center justify-center rounded-full
					transition-transform duration-200 group-focus-within/combobox:rotate-180">
				{{ render .GetContext .Input.TrailingIcon }}
			</div>
		</div>
        {{ render .GetContext .GetMenu }}
	</sds-combobox>

	<script defer>
		if (!customElements.get('sds-combobox')) customElements.define('sds-combobox', class extends HTMLElement {
			connectedCallback() {
				if (this.isInitialized) return;
				this.isInitialized = true;
				let trigger = this.querySelector('.js-combobox-trigger');
				let input = this.querySelector('.js-input');
				let menu = this.querySelector('menu');
				let menuItems = menu.querySelectorAll('[data-menu-option]');
				let menuSubheaders = menu.querySelectorAll('[data-menu-subheader]');
				let emptyState = menu.querySelector('[data-menu-empty]');
				let activeIndex = -1;
				input.addEventListener('keydown', function(e) {
					if (e.key !== 'Escape' || !menu.matches(':popover-open')) return;
					e.preventDefault();
					e.stopImmediatePropagation();
					menu.hidePopover();
				}, true);

				let visibleItems = function() {
					return Array.from(menuItems).filter(function(item) { return !item.hidden; });
				}
				let activateItem = function(index) {
					let items = visibleItems();
					menuItems.forEach(function(item) {
						item.removeAttribute('data-keyboard-active');
						item.classList.remove('bg-secondary-container');
					});
					if (items.length === 0) {
						activeIndex = -1;
						input.removeAttribute('aria-activedescendant');
						return;
					}
					activeIndex = (index + items.length) % items.length;
					items[activeIndex].setAttribute('data-keyboard-active', '');
					items[activeIndex].classList.add('bg-secondary-container');
					input.setAttribute('aria-activedescendant', items[activeIndex].id);
					items[activeIndex].scrollIntoView({ block: 'nearest' });
				}

				trigger.addEventListener('click', function() {
					input.focus();
					if (!menu.matches(':popover-open')) menu.showPopover();
				})
				input.addEventListener('keydown', function(e) {
					if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
						e.preventDefault();
						if (!menu.matches(':popover-open')) menu.showPopover();
						let nextIndex = activeIndex < 0 ? (e.key === 'ArrowDown' ? 0 : -1) :
							activeIndex + (e.key === 'ArrowDown' ? 1 : -1);
						activateItem(nextIndex);
					} else if (e.key === 'Enter') {
						let items = visibleItems();
						if (menu.matches(':popover-open') && items.length > 0) {
							e.preventDefault();
							items[activeIndex >= 0 ? activeIndex : 0].click();
						} else if (!menu.matches(':popover-open')) {
							e.preventDefault();
							menu.showPopover();
						}
					}
				})
				input.addEventListener('input', function() {
					activeIndex = -1;
					input.removeAttribute('aria-activedescendant');
					let query = input.value.toLocaleLowerCase();
					menuItems.forEach(function(item) {
						item.removeAttribute('data-keyboard-active');
						item.classList.remove('bg-secondary-container');
						item.hidden = !item.textContent.toLocaleLowerCase().includes(query);
					})
					menuSubheaders.forEach(function(subheader) {
						let sibling = subheader.nextElementSibling;
						let hasVisibleItem = false;
						while (sibling && !sibling.matches('[data-menu-subheader]')) {
							if (sibling.matches('[data-menu-option]') && !sibling.hidden) hasVisibleItem = true;
							sibling = sibling.nextElementSibling;
						}
						subheader.hidden = !hasVisibleItem;
					})
					if (emptyState) emptyState.hidden = visibleItems().length > 0;
					if (!menu.matches(':popover-open')) menu.showPopover();
				})

				menu.addEventListener('toggle', (e) => {
					input.setAttribute('aria-expanded', e.newState === 'open');
					if (e.newState !== 'open') {
						if (document.activeElement === input) input.blur();
						input.value = input.dataset.selectedValue;
						activeIndex = -1;
						input.removeAttribute('aria-activedescendant');
						menuItems.forEach(function(item) {
							item.hidden = false;
							item.removeAttribute('data-keyboard-active');
							item.classList.remove('bg-secondary-container');
						});
						menuSubheaders.forEach(function(subheader) { subheader.hidden = false; });
						if (emptyState) emptyState.hidden = true;
					}
				})
			}
		});
	</script>
{{ end }}
