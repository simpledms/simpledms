{{- /* gotype: github.com/simpledms/simpledms/core/ui/widget.Turnstile */ -}}
{{- define "Turnstile" }}
	<simpledms-turnstile
		id="{{ .GetID }}"
		data-sitekey="{{ .SiteKey }}"
		data-action="{{ .Action }}"
		data-error-message="{{ tr .GetContext "Verification failed. Please try again." }}"
		data-wait-message="{{ tr .GetContext "Please wait for verification to complete." }}"
		data-expired-message="{{ tr .GetContext "Verification expired. Please try again." }}"
		data-unavailable-message="{{ tr .GetContext "Verification is temporarily unavailable. Please try again." }}"
		data-submitting-message="{{ tr .GetContext "Registration is being submitted. Please wait." }}"
		data-timeout-message="{{ tr .GetContext "Verification timed out. Please try again." }}"
		style="display:block"
	>
		<div data-challenge></div>
		<noscript>{{ tr .GetContext "JavaScript is required for verification." }}</noscript>
	</simpledms-turnstile>
	<script>
		(function() {
			if (customElements.get('simpledms-turnstile')) return;

			let apiPromise;
			function loadAPI() {
				if (!apiPromise) {
					apiPromise = new Promise((resolve, reject) => {
						if (window.turnstile && typeof window.turnstile.render === 'function') {
							resolve(window.turnstile);
							return;
						}
						const script = document.createElement('script');
						script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
						script.async = true;
						script.defer = true;
						// ready() is incompatible with async/defer loading. The load event is our barrier.
						script.onload = () => resolve(window.turnstile);
						script.onerror = () => {
							apiPromise = null;
							script.remove();
							reject(new Error('Turnstile unavailable'));
						};
						document.head.append(script);
					});
				}
				return apiPromise;
			}

			customElements.define('simpledms-turnstile', class extends HTMLElement {
				connectedCallback() {
					if (this.lifecycle) return;
					const lifecycle = new AbortController();
					this.lifecycle = lifecycle;
					this.form = this.closest('form');
					this.tokenReady = false;
					this.pending = false;
					if (!this.form) return;

					// HTMX owns transport. Prevent submissions while a token is missing or in use.
					this.form.addEventListener('htmx:beforeRequest', event => {
						if (event.detail.elt !== this.form) return;
						if (this.pending) {
							event.preventDefault();
							this.showMessage(this.dataset.submittingMessage);
							return;
						}
						if (!this.tokenReady) {
							event.preventDefault();
							this.showMessage(this.dataset.waitMessage);
							return;
						}
						this.pending = true;
						this.tokenReady = false;
					}, {signal: lifecycle.signal});
					this.form.addEventListener('htmx:afterRequest', event => {
						if (event.detail.elt !== this.form || !this.pending) return;
						this.pending = false;
						this.tokenReady = false;
						if (this.widgetId !== undefined) window.turnstile.reset(this.widgetId);
					}, {signal: lifecycle.signal});

					loadAPI().then(api => {
						if (lifecycle.signal.aborted || !this.isConnected) return;
						this.widgetId = api.render(this.querySelector('[data-challenge]'), {
							sitekey: this.dataset.sitekey,
							action: this.dataset.action,
							size: 'flexible',
							callback: () => {
								this.tokenReady = true;
								this.dismissMessage?.();
							},
							'expired-callback': () => {
								this.tokenReady = false;
								this.showMessage(this.dataset.expiredMessage);
							},
							'error-callback': () => {
								this.tokenReady = false;
								this.showMessage(this.dataset.errorMessage);
							},
							'timeout-callback': () => {
								this.tokenReady = false;
								this.showMessage(this.dataset.timeoutMessage);
							},
						});
					}).catch(() => {
						if (!lifecycle.signal.aborted && this.isConnected) {
							this.showMessage(this.dataset.unavailableMessage);
						}
					});
				}

				showMessage(message) {
					if (!this.lifecycle || this.lifecycle.signal.aborted || !this.isConnected) return;
					const show = () => {
						if (this.isConnected && (!this.tokenReady || this.pending) &&
							typeof window.simpledmsShowClientSnackbar === 'function') {
							this.dismissMessage = window.simpledmsShowClientSnackbar(message);
						}
					};
					if (typeof window.simpledmsShowClientSnackbar === 'function') {
						show();
					} else {
						// On a full page load the snackbar runtime is a deferred script.
						window.addEventListener('load', show, {once: true, signal: this.lifecycle.signal});
					}
				}

				disconnectedCallback() {
					this.dismissMessage?.();
					this.lifecycle?.abort();
					this.lifecycle = null;
					if (this.widgetId !== undefined && window.turnstile) {
						window.turnstile.remove(this.widgetId);
						this.widgetId = undefined;
					}
				}
			});
		})();
	</script>
{{ end }}
