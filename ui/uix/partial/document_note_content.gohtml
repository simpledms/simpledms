{{- define "DocumentNoteContent" }}
	<div {{ with .ID }}id="{{ . }}"{{ end }} class="min-w-0 w-full">
		{{ if .IsSummary }}
		<button type="button" class="block w-full text-left cursor-pointer"
			{{ with .Tooltip }}data-tooltip="{{ .String $.GetContext }}"{{ end }}>
			<div class="body-md text-on-surface" style="white-space: pre-wrap; overflow-wrap: anywhere">{{ render .GetContext .Title }}</div>
			<div class="body-sm pt-1 text-on-surface-variant" style="white-space: pre-wrap; overflow-wrap: anywhere">{{ if .ReplacementReference }}<em>{{ render .GetContext .ReplacementReference }}</em>{{ else if .Status }}<em>{{ render .GetContext .Status }}</em>{{ else }}{{ .Body }}{{ end }}</div>
		</button>
		{{ else }}
		<div class="body-md pb-6 text-on-surface" style="white-space: pre-wrap; overflow-wrap: anywhere">{{ .Body }}</div>
		<div class="border-t border-outline-variant pt-4 pb-4 flex flex-col gap-2 text-on-surface-variant" style="overflow-wrap: anywhere">
			{{ range .Metadata }}
				<div class="body-sm">{{ render $.GetContext . }}</div>
			{{ end }}
		</div>
		{{ if .ReplacementReference }}
			<div class="body-sm pb-4 flex flex-col gap-2" style="overflow-wrap: anywhere">
				<em class="text-on-surface-variant">{{ render .GetContext .ReplacementReference }}</em>
				{{ if .ReplacementHref }}
					<a class="text-primary underline py-2" href="{{ .ReplacementHref }}" {{ template "HTMXAttrs" .ReplacementAttrs }}>{{ render .GetContext .ReplacementLabel }}</a>
				{{ end }}
			</div>
		{{ end }}
		{{ end }}
	</div>
{{ end }}
