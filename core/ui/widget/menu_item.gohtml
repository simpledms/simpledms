{{- /* gotype: github.com/simpledms/simpledms/core/ui/widget.MenuItem */ -}}
{{- define "menuItem" }}
	{{ $isAction := and .HTMXAttrs.IsLink (not .IsTypeRadio) (not .IsTypeCheckbox) }}
	<div
			id="{{ .GetID }}"
			data-menu-option
			data-selected="{{ .IsSelected }}"
			{{ if $isAction }}tabindex="0"{{ end }}
			{{ if .IsSelected }}aria-current="page"{{ end }}
			class="w-full h-12 text-on-surface cursor-pointer {{ if .IsDisabled }}text-on-surface/[0.38]{{ end }}"
            {{ template "HTMXAttrs" .HTMXAttrs }}
	>
		{{ if ne .DownloadLinkURL "" }}
		<a
				class="block h-12"
				href="{{ .DownloadLinkURL }}"
				filename="{{ .DownloadLinkFilename }}"
				hx-boost="false"
		>
            {{ end }}
			<div class="state-layer-on-surface flex items-center px-3 gap-x-3">
                {{- with .LeadingIcon }}
					<i class="material-symbols-outlined size-6 text-on-surface-variant {{ if $.IsSelected }}fill{{ end }}">{{ . }}</i>
                {{ end }}
				<span class="label-lg grow text-left hover:text-on-surface">{{ render .GetContext .Label }}</span>
                {{ with .GetTrailingIcon }}
					<i class="material-symbols-outlined text-on-surface-variant">{{ . }}</i>
                {{ end }}
                {{ .TrailingText }}
			</div>
		{{ if ne .DownloadLinkURL "" }}
		</a>
        {{ end }}
	</div>
	{{/* click propagation and keyboard activation are handled on the owning Menu */}}
{{ end }}

{{- define "MenuItem" }}
	{{ if .IsDivider }}
		{{ render .GetContext .GetDivider }}
	{{ else if .IsSubheader }}
		<div data-menu-subheader class="px-3 pt-3 pb-1 label-md text-on-surface-variant" role="heading" aria-level="2">
			{{ render .GetContext .Label }}
		</div>
	{{ else if .IsTypeRadio }}
		<label>
			<input
					type="radio"
					name="{{ .RadioGroupName }}"
					value="{{ .RadioValue }}"
					id="radio-{{ .GetID }}"
					{{ if .IsSelected }}checked{{ end }}
					class="hidden"
			/>
			{{ template "menuItem" . }}
		</label>
	{{ else if .IsTypeCheckbox }}
		<label>
			<input
					type="checkbox"
					name="{{ .CheckboxName }}"
					value="{{ .CheckboxValue }}"
					id="checkbox-{{ .GetID }}"
					{{ if .IsChecked }}checked{{ end }}
					class="hidden"
			/>
			{{ template "menuItem" . }}
		</label>
	{{ else }}
		{{ template "menuItem" . }}
	{{ end }}
{{ end }}
