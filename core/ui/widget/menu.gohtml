{{- /* gotype: github.com/simpledms/simpledms/core/ui/widget.Menu */ -}}
{{- define "Menu" }}
	{{/* hx-ext seems not inherited inside popover; needs verification
	if really popover causes issue */}}
	<menu
			id="{{ .GetID }}"
			class="border-outline-variant border inset-auto drop-shadow rounded-xs
			bg-surface-container max-h-svh overflow-y-auto position-area"
			role="menu"
			style="
					position-anchor: --{{ .GetID }};
					{{ if .MatchesAnchorWidth }}width: anchor-size(width);{{ end }}
					{{/*
						with position-area, inset-x values should no longer be necessary
						but they do not harm and are kept for backwards compatibility;
						the advantage of position-area, for example for PositionRight,
						is, that the menu (tooltip) is slowly moved to the top if there is no
						space left at the bottom; thus the intended position is preserved
						as long as possible and the menu (tooltip) is always fully visible or
						scrollable if to large.

						the values 'left' and 'right' are not fully supported yet
						as of 14.02.2026;

						TODO add position-area for bottom and top position
					*/}}
					inset-block-start: anchor(--{{ .GetID }} {{ .GetInsetBlockStart }});
					{{- if ne .GetInsetBlockEnd "" }}
						inset-block-end: anchor(--{{ .GetID }} {{ .GetInsetBlockEnd }});
					{{- end }}
					{{- if ne .GetInsetInlineEnd "" }}
						inset-inline-end: anchor(--{{ .GetID }} {{ .GetInsetInlineEnd }});
					{{- end }}
					{{- if ne .GetInsetInlineStart "" }}
						inset-inline-start: anchor(--{{ .GetID }} {{ .GetInsetInlineStart }});
					{{- end }}
					{{ if .IsPositionRight }}
						position-area: right span-bottom;
					{{ end }}
					{{ if .IsPositionLeft }}
						position-area: left span-bottom;
					{{ end }}
					"
			popover="{{ if .IsAutoPopover }}auto{{ else }}manual{{ end }}"
			{{/* Stopping clicks at the menu keeps stacked links, like a list item owning the menu,
			from being triggered. Actions are focusable divs (a button would break menus nested in
			an IconButton), so they also get keyboard activation. Listeners on the menu replace
			a script per item. */}}
			hx-on:click="event.stopPropagation()"
			hx-on:keydown="if ((event.key === 'Enter' || event.key === ' ') && event.target.matches('[data-menu-option][tabindex]')) { event.preventDefault(); event.target.click(); }"
			hx-ext="morph">
		{{/* if flex is set on <menu> it is rendered always independent of popover open or not */}}
		<div class="flex flex-col"{{ if .LazyItems }} {{ template "HTMXAttrs" .GetLazyItemsHTMXAttrs }}{{ end }}>
			{{ if .LazyItems }}
				<div class="h-12 label-lg text-on-surface-variant" role="status">
					<div class="flex h-full items-center px-3">{{ tr .GetContext "Loading…" }}</div>
				</div>
			{{ else }}
				{{ render .GetContext .Items }}
			{{ end }}
			{{ if .EmptyLabel }}
				<div data-menu-empty hidden class="h-12 label-lg text-on-surface-variant" role="status">
					<div class="flex h-full items-center px-3">
						{{ render .GetContext .EmptyLabel }}
					</div>
				</div>
			{{ end }}
		</div>
	</menu>
{{ end }}
