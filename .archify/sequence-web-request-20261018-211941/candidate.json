  "cards": [
    {
      "dot": "cyan",
      "title": "Shown path",
      "items": [
        "An authenticated request to an org/Space route through wrapTxResponse",
        "Routes without an org skip the tenant DB and run with a main-only context",
        "Commands may take the org and Space from HX-Current-URL"
      ]
    },
    {
      "dot": "rose",
      "title": "Exits before the handler",
      "items": [
        "No session on a protected path: snackbar and 303 to /",
        "Signed-in user opening / or /register/: 303 to the dashboard",
        "Setup sessions without a required passkey are sent to the dashboard"
      ]
    },
    {
      "dot": "amber",
      "title": "Variants not drawn",
      "items": [
        "Manual-tx actions commit the auth transactions before the handler runs",
        "/mcp and WebDAV have their own handlers mounted on the same mux",
        "Panics are recovered in wrapTxResponse and become error snackbars"
      ]
    }
  ]
